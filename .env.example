# Copy this file to `.env.local` for local development.
# Only `NEXT_PUBLIC_*` variables belong here — they are embedded in the browser bundle.
# Never commit secrets or private API keys to this file.

# Canonical origin for SEO metadata, Open Graph, sitemap, and robots.txt.
# Local development:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production (set in Vercel or your host after the first deploy — not committed):
# GitHub API shows no homepage or GitHub Pages for this repo yet (2026-04-23).
# Typical Vercel default for this project name:
# NEXT_PUBLIC_SITE_URL=https://kubernetes-manifest-readiness-analyzer.vercel.app

# Optional product analytics (disabled when unset — default is a strict no-op).
# NEXT_PUBLIC_AUTHOS_ANALYTICS_PROVIDER=custom-endpoint
# NEXT_PUBLIC_AUTHOS_ANALYTICS_ENDPOINT=https://your-reviewed-collector.example/events
